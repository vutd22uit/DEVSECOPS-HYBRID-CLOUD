# ================================================================= #
# HYBRID CLOUD CI/CD PIPELINE - ENVIRONMENT VARIABLES
# ================================================================= #
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ==========================================
# AWS Configuration
# ==========================================
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=257394468168
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ==========================================
# OpenStack Configuration
# ==========================================
# Harbor Registry
HARBOR_REGISTRY_URL=harbor.example.com
HARBOR_USERNAME=admin
HARBOR_PASSWORD=FoodHub@2025

# OpenStack Credentials (for Terraform)
OS_AUTH_URL=http://your-openstack:5000/v3
OS_USERNAME=admin
OS_PASSWORD=your-openstack-password
OS_PROJECT_NAME=foodhub
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default

# VPN Configuration
OPENSTACK_VPN_GATEWAY_IP=your-floating-ip
AWS_VPC_CIDR=10.1.0.0/16
OPENSTACK_NETWORK_CIDR=10.0.0.0/16
VPN_PRESHARED_KEY=your-secure-preshared-key

# ==========================================
# GitOps Configuration
# ==========================================
GITOPS_REPO_URL=github.com/NgHVu/dacn-config.git
GITOPS_USERNAME=your-github-username
GITOPS_TOKEN=ghp_your-github-personal-access-token

# ==========================================
# SonarQube Configuration
# ==========================================
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=squ_your-sonarqube-token
# Default credentials: admin/admin (change after first login)

# ==========================================
# Jenkins Configuration
# ==========================================
JENKINS_ADMIN_PASSWORD=admin123
# Change this after first setup!

# ==========================================
# Deployment Mode
# ==========================================
# Options: AWS, OPENSTACK, HYBRID
DEPLOYMENT_MODE=HYBRID

# ==========================================
# Kubernetes Contexts
# ==========================================
EKS_CONTEXT=foodhub-eks
OPENSTACK_K8S_CONTEXT=foodhub-openstack

# ==========================================
# Security Scanning
# ==========================================
TRIVY_SEVERITY=HIGH,CRITICAL
