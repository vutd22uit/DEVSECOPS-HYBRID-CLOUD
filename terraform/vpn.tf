# Customer Gateway for OpenStack VPN
resource "aws_customer_gateway" "openstack_cgw" {
  bgp_asn    = 65000
  ip_address = var.openstack_vpn_gateway_ip
  type       = "ipsec.1"

  tags = {
    Name = "${var.cluster_name}-openstack-cgw"
  }
}

# Virtual Private Gateway
resource "aws_vpn_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "${var.cluster_name}-vpn-gateway"
  }
}

# VPN Gateway attachment
resource "aws_vpn_gateway_attachment" "vpn_attachment" {
  vpc_id         = aws_vpc.main.id
  vpn_gateway_id = aws_vpn_gateway.main.id
}

# Site-to-Site VPN Connection
resource "aws_vpn_connection" "openstack" {
  vpn_gateway_id      = aws_vpn_gateway.main.id
  customer_gateway_id = aws_customer_gateway.openstack_cgw.id
  type                = "ipsec.1"
  static_routes_only  = true

  # Tunnel 1 options
  tunnel1_inside_cidr   = "169.254.10.0/30"
  tunnel1_preshared_key = var.vpn_preshared_key

  # Tunnel 2 options
  tunnel2_inside_cidr   = "169.254.11.0/30"
  tunnel2_preshared_key = var.vpn_preshared_key

  tags = {
    Name = "${var.cluster_name}-openstack-vpn"
  }
}

# Static route for OpenStack network
resource "aws_vpn_connection_route" "openstack_network" {
  destination_cidr_block = var.openstack_network_cidr
  vpn_connection_id      = aws_vpn_connection.openstack.id
}

# Enable route propagation for VPN Gateway
resource "aws_vpn_gateway_route_propagation" "public_subnet_1" {
  vpn_gateway_id = aws_vpn_gateway.main.id
  route_table_id = aws_route_table.public.id
}

resource "aws_vpn_gateway_route_propagation" "public_subnet_2" {
  vpn_gateway_id = aws_vpn_gateway.main.id
  route_table_id = aws_route_table.public.id
}

# Add route to OpenStack network in route table
resource "aws_route" "to_openstack" {
  route_table_id         = aws_route_table.public.id
  destination_cidr_block = var.openstack_network_cidr
  gateway_id             = aws_vpn_gateway.main.id
}

# Output VPN connection details
output "vpn_connection_id" {
  description = "ID of the VPN connection"
  value       = aws_vpn_connection.openstack.id
}

output "vpn_tunnel1_address" {
  description = "Public IP of VPN tunnel 1"
  value       = aws_vpn_connection.openstack.tunnel1_address
}

output "vpn_tunnel2_address" {
  description = "Public IP of VPN tunnel 2"
  value       = aws_vpn_connection.openstack.tunnel2_address
}

output "vpn_tunnel1_preshared_key" {
  description = "Pre-shared key for tunnel 1"
  value       = aws_vpn_connection.openstack.tunnel1_preshared_key
  sensitive   = true
}

output "vpn_tunnel2_preshared_key" {
  description = "Pre-shared key for tunnel 2"
  value       = aws_vpn_connection.openstack.tunnel2_preshared_key
  sensitive   = true
}

# Create configuration file for OpenStack VPN gateway
resource "local_file" "openstack_vpn_config" {
  filename = "${path.module}/../openstack/configs/aws-vpn-config.conf"
  content  = <<-EOF
    # AWS VPN Connection Configuration for OpenStack strongSwan
    # Generated by Terraform

    ═══════════════════════════════════════════════════════════════
    AWS VPN Configuration Details
    ═══════════════════════════════════════════════════════════════

    VPN Connection ID: ${aws_vpn_connection.openstack.id}

    Tunnel 1:
      - AWS Endpoint: ${aws_vpn_connection.openstack.tunnel1_address}
      - Inside CIDR: ${aws_vpn_connection.openstack.tunnel1_inside_cidr}
      - Pre-shared Key: ${aws_vpn_connection.openstack.tunnel1_preshared_key}

    Tunnel 2:
      - AWS Endpoint: ${aws_vpn_connection.openstack.tunnel2_address}
      - Inside CIDR: ${aws_vpn_connection.openstack.tunnel2_inside_cidr}
      - Pre-shared Key: ${aws_vpn_connection.openstack.tunnel2_preshared_key}

    Local Network: ${var.openstack_network_cidr}
    Remote Network: ${aws_vpc.main.cidr_block}

    ═══════════════════════════════════════════════════════════════

    # /etc/ipsec.conf configuration

    config setup
        charondebug="ike 2, knl 2, cfg 2, net 2, esp 2, dmn 2, mgr 2"
        uniqueids=never

    conn aws-tunnel1
        type=tunnel
        authby=secret
        left=%defaultroute
        leftsubnet=${var.openstack_network_cidr}
        right=${aws_vpn_connection.openstack.tunnel1_address}
        rightsubnet=${aws_vpc.main.cidr_block}
        ike=aes256-sha256-modp2048!
        esp=aes256-sha256-modp2048!
        keyingtries=%forever
        ikelifetime=8h
        lifetime=1h
        dpddelay=10s
        dpdtimeout=30s
        dpdaction=restart
        auto=start

    conn aws-tunnel2
        type=tunnel
        authby=secret
        left=%defaultroute
        leftsubnet=${var.openstack_network_cidr}
        right=${aws_vpn_connection.openstack.tunnel2_address}
        rightsubnet=${aws_vpc.main.cidr_block}
        ike=aes256-sha256-modp2048!
        esp=aes256-sha256-modp2048!
        keyingtries=%forever
        ikelifetime=8h
        lifetime=1h
        dpddelay=10s
        dpdtimeout=30s
        dpdaction=restart
        auto=start

    ═══════════════════════════════════════════════════════════════

    # /etc/ipsec.secrets configuration

    : PSK "${aws_vpn_connection.openstack.tunnel1_preshared_key}"

    ═══════════════════════════════════════════════════════════════
  EOF

  file_permission = "0600"
}
