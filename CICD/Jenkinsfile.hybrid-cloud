pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
        timeout(time: 90, unit: 'MINUTES')
        timestamps()
        ansiColor('xterm')
    }

    environment {
        // --- HYBRID CLOUD CONFIGURATION ---
        DEPLOYMENT_MODE = 'HYBRID' // Options: AWS, OPENSTACK, HYBRID

        // --- AWS CONFIGURATION ---
        AWS_REGION      = 'ap-southeast-1'
        AWS_ACCOUNT_ID  = '257394468168'
        ECR_REGISTRY    = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        // --- OPENSTACK CONFIGURATION ---
        HARBOR_REGISTRY = credentials('harbor-registry-url') // e.g., harbor.example.com
        HARBOR_PROJECT  = 'foodhub'
        HARBOR_CREDS    = credentials('harbor-credentials')

        // --- KUBERNETES CONTEXTS ---
        EKS_CONTEXT     = 'foodhub-eks'
        OPENSTACK_K8S_CONTEXT = 'foodhub-openstack'

        // --- SECURITY & CACHE ---
        TRIVY_SEVERITY  = 'HIGH,CRITICAL'
        SCAN_CACHE_DIR  = "/var/lib/jenkins/.trivy-cache"

        // --- GITOPS (ArgoCD) ---
        GITOPS_REPO_URL = "github.com/NgHVu/dacn-config.git"
        GITOPS_CRED_ID  = "github-pat"

        // --- SONARQUBE ---
        SONAR_AUTH_TOKEN = credentials('sonar-token')
        SONAR_HOST_URL   = 'http://localhost:9000'
    }

    stages {
        stage('1. Initialize') {
            steps {
                script {
                    sh 'chmod +x scripts/*.sh'

                    // Create cache directories
                    sh "mkdir -p ${SCAN_CACHE_DIR}"
                    sh "mkdir -p /var/lib/jenkins/.m2/repository"
                    sh "mkdir -p /var/lib/jenkins/.npm"

                    env.COMMIT_HASH = sh(script: 'git rev-parse --short=7 HEAD', returnStdout: true).trim()
                    if (env.BRANCH_NAME == 'main') {
                        env.IMAGE_TAG = env.COMMIT_HASH
                    } else {
                        env.IMAGE_TAG = "${env.BRANCH_NAME}-${env.COMMIT_HASH}"
                    }

                    echo """
                    ═══════════════════════════════════════════════════════════════
                    🌐 HYBRID CLOUD CI/CD PIPELINE
                    ═══════════════════════════════════════════════════════════════
                    Branch:      ${env.BRANCH_NAME}
                    Commit:      ${env.COMMIT_HASH}
                    Image Tag:   ${env.IMAGE_TAG}
                    Mode:        ${DEPLOYMENT_MODE}
                    AWS EKS:     ${EKS_CONTEXT}
                    OpenStack:   ${OPENSTACK_K8S_CONTEXT}
                    ═══════════════════════════════════════════════════════════════
                    """
                }

                // Login to AWS ECR
                sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"

                // Login to Harbor Registry
                script {
                    if (env.DEPLOYMENT_MODE == 'OPENSTACK' || env.DEPLOYMENT_MODE == 'HYBRID') {
                        sh "echo ${HARBOR_CREDS_PSW} | docker login ${HARBOR_REGISTRY} -u ${HARBOR_CREDS_USR} --password-stdin"
                    }
                }
            }
        }

        stage('2. Build & Deploy Microservices') {
            parallel {
                // ==========================================
                // USERS SERVICE
                // ==========================================
                stage('Users Service') {
                    when {
                        anyOf {
                            triggeredBy 'UserIdCause'
                            expression { return currentBuild.previousBuild == null }
                            changeset "services/users/**"
                        }
                    }
                    environment { SERVICE_NAME = 'users' }
                    stages {
                        stage('Users: Code Analysis') {
                            agent {
                                docker {
                                    image 'maven:3.9-eclipse-temurin-21'
                                    args '--network host -v /var/lib/jenkins/.m2:/root/.m2 -u 0:0'
                                    reuseNode true
                                }
                            }
                            steps {
                                withSonarQubeEnv('sonarqube-local') {
                                    sh "./scripts/analyze-backend.sh ${SERVICE_NAME}"
                                }
                            }
                            post { always { sh "rm -rf services/${SERVICE_NAME}/target" } }
                        }

                        stage('Users: Security Scan') {
                            steps {
                                sh "./scripts/security-scan.sh ${SERVICE_NAME} ${SCAN_CACHE_DIR} ${TRIVY_SEVERITY}"
                            }
                        }

                        stage('Users: Build & Push') {
                            steps {
                                script {
                                    def registries = []
                                    if (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        registries << "${ECR_REGISTRY}/foodhub-${SERVICE_NAME}"
                                    }
                                    if (env.DEPLOYMENT_MODE == 'OPENSTACK' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        registries << "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/foodhub-${SERVICE_NAME}"
                                    }
                                    
                                    if (registries) {
                                        echo "📦 Building and pushing to: ${registries.join(', ')}"
                                        sh "./scripts/docker-build-push.sh ${SERVICE_NAME} ${env.IMAGE_TAG} ${registries.join(' ')}"
                                    }
                                }
                            }
                        }

                        stage('Users: Image Scan') {
                            steps {
                                script {
                                    def scanImage = (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') ? 
                                        "${ECR_REGISTRY}/foodhub-${SERVICE_NAME}:${env.IMAGE_TAG}" :
                                        "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/foodhub-${SERVICE_NAME}:${env.IMAGE_TAG}"
                                    
                                    echo "🛡️ Scanning Image: ${scanImage}"
                                    sh "trivy image --cache-dir ${SCAN_CACHE_DIR} --severity ${TRIVY_SEVERITY} --exit-code 0 ${scanImage}"
                                }
                            }
                        }

                        stage('Users: Deploy to Clusters') {
                            when { branch 'main' }
                            steps {
                                script {
                                    if (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        stage('Deploy Users to AWS') {
                                            updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}", "aws")
                                        }
                                    }
                                    if (env.DEPLOYMENT_MODE == 'OPENSTACK' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        stage('Deploy Users to OpenStack') {
                                            updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}", "openstack")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // PRODUCTS SERVICE
                // ==========================================
                stage('Products Service') {
                    when {
                        anyOf {
                            triggeredBy 'UserIdCause'
                            expression { return currentBuild.previousBuild == null }
                            changeset "services/products/**"
                        }
                    }
                    environment { SERVICE_NAME = 'products' }
                    stages {
                        stage('Products: Code Analysis') {
                            agent {
                                docker {
                                    image 'maven:3.9-eclipse-temurin-21'
                                    args '--network host -v /var/lib/jenkins/.m2:/root/.m2 -u 0:0'
                                    reuseNode true
                                }
                            }
                            steps {
                                withSonarQubeEnv('sonarqube-local') {
                                    sh "./scripts/analyze-backend.sh ${SERVICE_NAME}"
                                }
                            }
                            post { always { sh "rm -rf services/${SERVICE_NAME}/target" } }
                        }

                        stage('Products: Security Scan') {
                            steps {
                                sh "./scripts/security-scan.sh ${SERVICE_NAME} ${SCAN_CACHE_DIR} ${TRIVY_SEVERITY}"
                            }
                        }

                        stage('Products: Build & Push') {
                            steps {
                                script {
                                    def registries = []
                                    if (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        registries << "${ECR_REGISTRY}/foodhub-${SERVICE_NAME}"
                                    }
                                    if (env.DEPLOYMENT_MODE == 'OPENSTACK' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        registries << "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/foodhub-${SERVICE_NAME}"
                                    }
                                    if (registries) {
                                        sh "./scripts/docker-build-push.sh ${SERVICE_NAME} ${env.IMAGE_TAG} ${registries.join(' ')}"
                                    }
                                }
                            }
                        }

                        stage('Products: Image Scan') {
                            steps {
                                script {
                                    def scanImage = (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') ? 
                                        "${ECR_REGISTRY}/foodhub-${SERVICE_NAME}:${env.IMAGE_TAG}" :
                                        "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/foodhub-${SERVICE_NAME}:${env.IMAGE_TAG}"
                                    sh "trivy image --cache-dir ${SCAN_CACHE_DIR} --severity ${TRIVY_SEVERITY} --exit-code 0 ${scanImage}"
                                }
                            }
                        }

                        stage('Products: Deploy to Clusters') {
                            when { branch 'main' }
                            steps {
                                script {
                                    if (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        stage('Deploy Products to AWS') {
                                            updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}", "aws")
                                        }
                                    }
                                    if (env.DEPLOYMENT_MODE == 'OPENSTACK' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        stage('Deploy Products to OpenStack') {
                                            updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}", "openstack")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // ORDERS SERVICE
                // ==========================================
                stage('Orders Service') {
                    when {
                        anyOf {
                            triggeredBy 'UserIdCause'
                            expression { return currentBuild.previousBuild == null }
                            changeset "services/orders/**"
                        }
                    }
                    environment { SERVICE_NAME = 'orders' }
                    stages {
                        stage('Orders: Code Analysis') {
                            agent {
                                docker {
                                    image 'maven:3.9-eclipse-temurin-21'
                                    args '--network host -v /var/lib/jenkins/.m2:/root/.m2 -u 0:0'
                                    reuseNode true
                                }
                            }
                            steps {
                                withSonarQubeEnv('sonarqube-local') {
                                    sh "./scripts/analyze-backend.sh ${SERVICE_NAME}"
                                }
                            }
                            post { always { sh "rm -rf services/${SERVICE_NAME}/target" } }
                        }

                        stage('Orders: Security Scan') {
                            steps {
                                sh "./scripts/security-scan.sh ${SERVICE_NAME} ${SCAN_CACHE_DIR} ${TRIVY_SEVERITY}"
                            }
                        }

                        stage('Orders: Build & Push') {
                            steps {
                                script {
                                    def registries = []
                                    if (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        registries << "${ECR_REGISTRY}/foodhub-${SERVICE_NAME}"
                                    }
                                    if (env.DEPLOYMENT_MODE == 'OPENSTACK' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        registries << "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/foodhub-${SERVICE_NAME}"
                                    }
                                    if (registries) {
                                        sh "./scripts/docker-build-push.sh ${SERVICE_NAME} ${env.IMAGE_TAG} ${registries.join(' ')}"
                                    }
                                }
                            }
                        }

                        stage('Orders: Image Scan') {
                            steps {
                                script {
                                    def scanImage = (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') ? 
                                        "${ECR_REGISTRY}/foodhub-${SERVICE_NAME}:${env.IMAGE_TAG}" :
                                        "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/foodhub-${SERVICE_NAME}:${env.IMAGE_TAG}"
                                    sh "trivy image --cache-dir ${SCAN_CACHE_DIR} --severity ${TRIVY_SEVERITY} --exit-code 0 ${scanImage}"
                                }
                            }
                        }

                        stage('Orders: Deploy to Clusters') {
                            when { branch 'main' }
                            steps {
                                script {
                                    if (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        stage('Deploy Orders to AWS') {
                                            updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}", "aws")
                                        }
                                    }
                                    if (env.DEPLOYMENT_MODE == 'OPENSTACK' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        stage('Deploy Orders to OpenStack') {
                                            updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}", "openstack")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ==========================================
                // FRONTEND SERVICE
                // ==========================================
                stage('Frontend Service') {
                    when {
                        anyOf {
                            triggeredBy 'UserIdCause'
                            expression { return currentBuild.previousBuild == null }
                            changeset "services/frontend/**"
                        }
                    }
                    environment { SERVICE_NAME = 'frontend' }
                    stages {
                        stage('Frontend: Code Analysis') {
                            agent {
                                docker {
                                    image 'node:20-alpine'
                                    args '--network host -v /var/lib/jenkins/.npm:/root/.npm -u 0:0'
                                    reuseNode true
                                }
                            }
                            steps {
                                withSonarQubeEnv('sonarqube-local') {
                                    sh "./scripts/analyze-frontend.sh ${SERVICE_NAME}"
                                }
                            }
                            post { always { sh "rm -rf services/${SERVICE_NAME}/node_modules services/${SERVICE_NAME}/.next" } }
                        }

                        stage('Frontend: Security Scan') {
                            steps {
                                sh "./scripts/security-scan.sh ${SERVICE_NAME} ${SCAN_CACHE_DIR} ${TRIVY_SEVERITY}"
                            }
                        }

                        stage('Frontend: Build & Push') {
                            steps {
                                script {
                                    def registries = []
                                    if (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        registries << "${ECR_REGISTRY}/foodhub-${SERVICE_NAME}"
                                    }
                                    if (env.DEPLOYMENT_MODE == 'OPENSTACK' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        registries << "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/foodhub-${SERVICE_NAME}"
                                    }
                                    if (registries) {
                                        sh "./scripts/docker-build-push.sh ${SERVICE_NAME} ${env.IMAGE_TAG} ${registries.join(' ')}"
                                    }
                                }
                            }
                        }

                        stage('Frontend: Image Scan') {
                            steps {
                                script {
                                    def scanImage = (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') ? 
                                        "${ECR_REGISTRY}/foodhub-${SERVICE_NAME}:${env.IMAGE_TAG}" :
                                        "${HARBOR_REGISTRY}/${HARBOR_PROJECT}/foodhub-${SERVICE_NAME}:${env.IMAGE_TAG}"
                                    sh "trivy image --cache-dir ${SCAN_CACHE_DIR} --severity ${TRIVY_SEVERITY} --exit-code 0 ${scanImage}"
                                }
                            }
                        }

                        stage('Frontend: Deploy to Clusters') {
                            when { branch 'main' }
                            steps {
                                script {
                                    if (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        stage('Deploy Frontend to AWS') {
                                            updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}", "aws")
                                        }
                                    }
                                    if (env.DEPLOYMENT_MODE == 'OPENSTACK' || env.DEPLOYMENT_MODE == 'HYBRID') {
                                        stage('Deploy Frontend to OpenStack') {
                                            updateGitOps("${SERVICE_NAME}", "${env.IMAGE_TAG}", "openstack")
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('3. Health Check') {
            when { branch 'main' }
            steps {
                script {
                    echo "🏥 Starting Health Checks for Microservices..."

                    def checkService = { context, cloudName ->
                        echo "🔍 Checking status on ${cloudName}..."
                        sh "kubectl --context ${context} get pods -n foodhub"
                        sh """
                            for service in users products orders frontend; do
                                echo "Checking status of \$service..."
                                kubectl --context ${context} rollout status deployment/\$service -n foodhub --timeout=60s
                            done
                        """
                    }

                    if (env.DEPLOYMENT_MODE == 'AWS' || env.DEPLOYMENT_MODE == 'HYBRID') {
                        checkService(env.EKS_CONTEXT, "AWS EKS")
                    }

                    if (env.DEPLOYMENT_MODE == 'OPENSTACK' || env.DEPLOYMENT_MODE == 'HYBRID') {
                        checkService(env.OPENSTACK_K8S_CONTEXT, "OpenStack K8s")
                    }
                }
            }
        }
    }

    post {
        success {
            echo """
            ═══════════════════════════════════════════════════════════════
            ✅ HYBRID CLOUD CI/CD PIPELINE SUCCESSFUL
            ═══════════════════════════════════════════════════════════════
            Branch:      ${env.BRANCH_NAME}
            Commit:      ${env.COMMIT_HASH}
            Image Tag:   ${env.IMAGE_TAG}
            Mode:        ${DEPLOYMENT_MODE}
            ═══════════════════════════════════════════════════════════════
            """
        }
        failure {
            echo """
            ═══════════════════════════════════════════════════════════════
            ❌ HYBRID CLOUD CI/CD PIPELINE FAILED
            ═══════════════════════════════════════════════════════════════
            Branch:      ${env.BRANCH_NAME}
            Commit:      ${env.COMMIT_HASH}
            Check logs for details
            ═══════════════════════════════════════════════════════════════
            """
        }
    }
}

// ==========================================
// HELPER FUNCTIONS
// ==========================================

def updateGitOps(String serviceName, String imageTag, String cloudProvider) {
    def gitOpsDir = "gitops-config-${cloudProvider}-${serviceName}"
    def valuesFile = "services/${serviceName}/${cloudProvider}/values.yaml"

    echo "📝 Updating GitOps for ${serviceName} in ${cloudProvider}..."

    withCredentials([string(credentialsId: env.GITOPS_CRED_ID, variable: 'GIT_TOKEN')]) {
        sh """
            rm -rf ${gitOpsDir}
            git clone https://${GIT_TOKEN}@${env.GITOPS_REPO_URL} ${gitOpsDir}
            cd ${gitOpsDir}

            if [ -f "${valuesFile}" ]; then
                # Use a more reliable sed command
                sed -i "s|tag:.*|tag: ${imageTag}|" ${valuesFile}

                git config user.name "Jenkins CI"
                git config user.email "jenkins@foodhub.local"
                git add ${valuesFile}
                
                if ! git diff-index --quiet HEAD; then
                    git commit -m "Update ${serviceName} image to ${imageTag} for ${cloudProvider}"
                    git push origin main
                else
                    echo "No changes to commit for ${serviceName} in ${cloudProvider}"
                fi
            else
                echo "Warning: ${valuesFile} not found in GitOps repo"
                ls -R
            fi
        """
    }
}
